# Copy to .env on the VPS. Never commit the filled file.
# The private key is the plant treasury and the Drain. Child keys for Kepler, Lumen, the Battery,
# the city, and the owners are derived in memory and are not stored.
PEAQOS_RPC_URL=https://peaq-agung.api.onfinality.io/public
PEAQOS_PRIVATE_KEY=
# Or point at a key file outside the repo:
# PEAQOS_PRIVATE_KEY_FILE=/etc/fuel-the-robot-economy/agung.key
TOKENOMICS_DEPLOYMENT_ID=agung-2026-08-28
HOST=0.0.0.0
PORT=4317
